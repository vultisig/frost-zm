FROM rust:1.89-bookworm AS rust-builder

WORKDIR /build
COPY frosty-lib/Cargo.toml frosty-lib/Cargo.lock ./
COPY frosty-lib/crates/ crates/

RUN cargo build --release -p fromt-lib

FROM golang:1.24-bookworm AS go-builder

COPY --from=rust-builder /build/target/release/libfromtlib.so /usr/lib/
RUN ldconfig

WORKDIR /build

COPY frosty-lib/go/ go/
COPY frosty-lib/client/fromt/ client/fromt/
COPY frosty-lib/client/shared/ client/shared/

COPY --from=rust-builder /build/crates/fromt-lib/include/fromt-lib.h go/fromt/includes/
RUN ARCH=$(dpkg --print-architecture) && \
    if [ "$ARCH" = "amd64" ]; then LIBDIR=linux-amd64; else LIBDIR=linux-arm64; fi && \
    mkdir -p go/fromt/includes/$LIBDIR && \
    cp /usr/lib/libfromtlib.so go/fromt/includes/$LIBDIR/

COPY commondata/ commondata/
COPY vultiserver/ vultiserver/

WORKDIR /build/vultiserver
RUN CGO_ENABLED=1 go build -o /vultisigner ./cmd/vultisigner && \
    CGO_ENABLED=1 go build -o /worker ./cmd/worker && \
    find /go/pkg/mod/github.com/vultisig/go-wrappers*/includes/linux -name "*.so" -exec cp {} /usr/lib/ \;

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*

COPY --from=rust-builder /build/target/release/libfromtlib.so /usr/lib/
COPY --from=go-builder /usr/lib/libgodkls.so /usr/lib/
COPY --from=go-builder /usr/lib/libgoschnorr.so /usr/lib/
RUN ldconfig

COPY --from=go-builder /vultisigner /usr/local/bin/vultisigner
COPY --from=go-builder /worker /usr/local/bin/worker

RUN mkdir -p /data/vaults

EXPOSE 8080
